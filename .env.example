# IT Vendor Renewal Agent - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Low-utilisation threshold (%). Default: 70
# UTIL_LOW_THRESHOLD=70

# Deadline warning window (days). Default: 60
# DEADLINE_WARNING_DAYS=60

# Deadline urgent window (days). Default: 30
# DEADLINE_URGENT_DAYS=30

# Output directory (relative to project root). Default: outputs
# OUTPUT_DIR=outputs

# Data directory (relative to project root). Default: data
# DATA_DIR=data

# Logging level: DEBUG, INFO, WARNING, ERROR. Default: INFO
# LOG_LEVEL=INFO

# Optional: LLM API key (if using LLM for explanation enrichment in future)
# Keep secrets out of source code. Never commit this file with values filled in.
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
